# Required: your hermai API key. Never commit the real value or ship it to the browser.
HERMAI_API_KEY=[your_key_here]

HERMAI_SOURCE_SITE=nhtsa.gov
HERMAI_SOURCE_ENDPOINT=sgo_ads_incidents

# Required for the scheduled refresh (see vercel.json). Any long random
# string works — Vercel Cron sends it back as "Authorization: Bearer <value>"
# so /api/cron/refresh can confirm the request actually came from Vercel.
CRON_SECRET=kp24-ih-erg-cehmrghoer-igeg-kp24

# Optional
PORT=3000
